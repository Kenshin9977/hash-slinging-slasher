/target

# This machine's paths and settings. config.example.toml is the committed template.
/config.toml

# The captured asset ids are committed, not fetched. They are 26 MB for both games and cost the
# history that once, because a snapshot is only ever re-cut when a game is patched and neither of
# these games will be again. A clone is therefore able to confirm names with nothing downloaded.

# The hash tables, which go stale in a day and are fetched rather than committed. The checkout
# itself lands beside the tables folder, at the repository root.
/tables/
/cod-name-db/

# This machine's own results and whatever is queued to send.
/findings/
/submissions/
/logs/

# What `start` learned about the world: which names are already claimed by a merged submission or
# an open pull request, and which searches have already been run to exhaustion. Regenerated every
# time `start` runs, and specific to this clone's moment, so it is never committed.
/state/

# Scripts this machine wants to contribute. `submit` reads them from here and puts them in the
# pull request itself, so they do not need to be committed locally first.
/contrib/

# IDE and Python caches.
/.idea/
__pycache__/

# Previous-run backups written by derive_lists.py.
*.prev

# Plans, and the stem lists beside them. `seam_stems.py --write-plan` writes both, and a stem list
# is six figures of lines that regenerate from the tables in a minute -- so the plan is a local
# working file, not a thing to carry. `plans/example.txt` is the committed one, and it is
# committed because it is the format's documentation.
/plans/*
!/plans/example.txt

# The report gpuinfo writes for somebody to send. Theirs, not the repository.
gpuinfo-report.txt

# Crash debris from a shell that fell over. Never part of a submission.
*.stackdump
